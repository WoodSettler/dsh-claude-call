{
  "name": "dsh-claude-call",
  "version": "0.1.1",
  "private": true,
  "description": "Local bridge that lets Claude Code wake a DSH session, dispatch a task, and read the answer back.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "mcp/server.mjs",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
